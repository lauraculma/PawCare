# Puerto publico de la aplicacion (Nginx / frontend)
APP_PORT=3000

# Base de datos PostgreSQL
DB_NAME=pawcare
DB_USERNAME=pawcare_user
DB_PASSWORD=cambia_esta_clave
DB_PORT=5432

# Backend Spring Boot
BACKEND_PORT=8080
JWT_SECRET=cambia_este_secreto_por_uno_de_al_menos_32_caracteres
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost

# URL que usa el frontend para llamar a la API
# Con Nginx usa ruta relativa
NEXT_PUBLIC_API_URL=/api
# Para desarrollo local sin Nginx usar: http://localhost:8080/api

# Credenciales demo
# Owner de prueba
DEMO_OWNER_EMAIL=test@example.com
DEMO_OWNER_PASSWORD=TestPass123
# Veterinario de prueba
DEMO_VET_EMAIL=vet@test.com
DEMO_VET_PASSWORD=VetPass123

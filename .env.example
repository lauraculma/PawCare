# Puerto publico de PawCare (Nginx)
APP_PORT=80

# PostgreSQL dentro de Docker. El puerto externo evita conflictos con PostgreSQL local.
DB_NAME=pawcare
DB_PORT=5434
DB_USERNAME=pawcare
DB_PASSWORD=CAMBIA_ESTA_CLAVE_POR_UNA_SEGURA

# JWT: usa una cadena aleatoria larga y privada (minimo 32 caracteres).
JWT_SECRET=CAMBIA_ESTE_SECRETO_POR_UNO_ALEATORIO_DE_32_CARACTERES_O_MAS
JWT_EXPIRATION_MINUTES=120
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# Administrador inicial. Se crea una sola vez si el correo aun no existe.
# Despues de crear el administrador, cambia BOOTSTRAP_ADMIN_ENABLED a false.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Administrador PawCare
